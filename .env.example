# Signalpost configuration. Copy to .env and adjust. No API keys are required:
# all sources are Brønnøysund Register Centre open data (NLOD 2.0), free of charge.

SIGNALPOST_DB=data/signalpost.sqlite3

# Competition limits per daily run (hard-enforced by the HTTP client)
SIGNALPOST_MAX_REQUESTS=2000
SIGNALPOST_MAX_SECONDS=2700

# HTTP behaviour
SIGNALPOST_TIMEOUT=20
SIGNALPOST_MAX_RETRIES=3
SIGNALPOST_BACKOFF=1.0
SIGNALPOST_MIN_INTERVAL=0.1
SIGNALPOST_CACHE_TTL=3600

# Enrichment (1 extra request per company each)
SIGNALPOST_ROLES=1
SIGNALPOST_FINANCIALS=1

# Source endpoints (override only for testing)
SIGNALPOST_BRREG_BASE=https://data.brreg.no/enhetsregisteret/api
SIGNALPOST_REGNSKAP_BASE=https://data.brreg.no/regnskapsregisteret/regnskap
